#!/bin/bash -e

# The program being started decides which database role it uses (milestone
# 2 plan EN-24). DATABASE_URL names the owner role: migrations, db:prepare,
# db:grants, every test run and every other command keep it. The server and
# the sweep run as the login role leverage_api when API_DATABASE_URL is set.

server=false
sweep=false
if [[ "${@: -2:1}" == "./bin/rails" || "${@: -2:1}" == "bin/rails" ]] && [ "${@: -1:1}" == "server" ]; then
  server=true
fi
if [[ "${1}" == "bin/sweep" || "${1}" == "./bin/sweep" ]]; then
  sweep=true
fi

# Before the server: create or migrate the database as the owner role.
# db:prepare runs db:grants after it (lib/tasks/db_grants.rake), which also
# creates leverage_api and sets its password from LEVERAGE_API_DB_PASSWORD.
# Then every workspace that has no rule gets the seven shipped rules, once,
# through the transition function (milestone 4 plan RD-2); a workspace that
# has its rules is left alone. Then every workspace that has no Imaginarium
# project gets it, once, the same way (DB-53); one that has it is left alone.
if $server; then
  ./bin/rails db:prepare
  ./bin/rails leverage:install_shipped_rules
  ./bin/rails leverage:install_imaginarium_project
fi

# If running the tests then create or migrate the test database first, so
# that `docker compose run --rm api bin/rails test` works on a fresh volume
if [[ "${1}" == "bin/rails" || "${1}" == "./bin/rails" ]] && [ "${2}" == "test" ]; then
  RAILS_ENV=test ./bin/rails db:prepare
fi

# The server and the sweep connect as leverage_api, and keep neither the
# owner role's password nor the login role's own in their environment.
if { $server || $sweep; } && [ -n "${API_DATABASE_URL}" ]; then
  export DATABASE_URL="${API_DATABASE_URL}"
  unset API_DATABASE_URL POSTGRES_PASSWORD LEVERAGE_API_DB_PASSWORD
fi

exec "${@}"
