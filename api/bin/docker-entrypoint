#!/bin/bash -e

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
fi

# If running the tests then create or migrate the test database first, so
# that `docker compose run --rm api bin/rails test` works on a fresh volume
if [[ "${1}" == "bin/rails" || "${1}" == "./bin/rails" ]] && [ "${2}" == "test" ]; then
  RAILS_ENV=test ./bin/rails db:prepare
fi

exec "${@}"
