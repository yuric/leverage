{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task.created v2",
  "description": "Add a task from the Imaginarium. The task lands in Ideas or Backlog.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "state": {
      "description": "The state the task was created in.",
      "enum": [
        "ideas",
        "backlog"
      ]
    },
    "added_action_ids": {
      "description": "IDs of the contracted outward actions added with the task, in contract order.",
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "imaginarium_entry": {
      "description": "The catalog entry id. The catalog version is stored on the task.",
      "enum": [
        "bedtime-story-book",
        "birthday-time-capsule",
        "budget-jars",
        "chore-wheel",
        "downloads-tidy-up",
        "field-guide-plate",
        "flashcard-coach",
        "glass-portfolio",
        "habit-streaks",
        "inside-joke-crossword",
        "link-in-bio-page",
        "loud-launch-page",
        "math-quest",
        "meal-planner",
        "menu-bar-pet",
        "neon-synthwave-poster",
        "our-story-timeline",
        "party-rsvp-site",
        "pet-runner",
        "photo-renamer",
        "plant-care-tracker",
        "playable-explainer",
        "pocket-to-do",
        "receipt-sorter",
        "recipe-box",
        "storybook-pet-portrait",
        "tiny-clay-world",
        "trip-planner-map",
        "trivia-night-host",
        "typing-trainer",
        "weekly-folder-digest",
        "word-garden"
      ]
    },
    "added_criterion_ids": {
      "description": "The ids of the criteria saved with an Imaginarium idea, in contract order.",
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "state",
    "added_action_ids",
    "imaginarium_entry",
    "added_criterion_ids"
  ],
  "examples": [
    {
      "state": "backlog",
      "added_action_ids": [],
      "imaginarium_entry": "pocket-to-do",
      "added_criterion_ids": []
    },
    {
      "state": "ideas",
      "added_action_ids": [],
      "imaginarium_entry": "pocket-to-do",
      "added_criterion_ids": [
        "00000000-0000-4000-8000-000000000121",
        "00000000-0000-4000-8000-000000000122",
        "00000000-0000-4000-8000-000000000123"
      ]
    }
  ]
}
