      "caller": "$user:owner",
      "command": "complete_contract",
      "operation_id": "complete_contract",
      "key": "$key:t1_complete",
      "path_params": {"id": "$task:1"},
      "body": {"title": "Update the pricing page", "goal": "The page shows this year's prices.", "details": "Use the figures in the brief.", "criteria": [{"text": "Criterion build of task 1 holds.", "kind": "build"}, {"text": "An independent reviewer agrees.", "kind": "review"}], "actions": [], "minimum_strength_rank": null, "budget_cap": null, "work_reference": null},
      "expect": {
        "outcome": "completed",
        "refusal": null,
        "events": [
          {"ref": "@event:2", "type": "check.finished", "schema_version": 1, "at": "@t:10", "effective_at": "@t:10", "actor_kind": "owner", "actor_id": "$user:owner", "project_id": "$project:site", "task_id": "$task:1", "round": 0, "subject_kind": "rule_check", "subject_id": "$rule_check:t1_criteria", "cause_id": null, "command_id": "$key:t1_complete", "payload": {"hook": "task.before_ready", "rule_id": "$rule:acceptance_criteria", "rule_version_id": "$rule_version:acceptance_criteria_1", "result": "passed", "effect": null, "wait_cause": null, "subject_kind": null, "subject_id": null, "input_hash": "a0e28787b83f69af1efceeb25b5b2f549e74f5791589c5acb92c8c93ba3cb188"}},
          {"ref": "@event:3", "type": "task.contract_changed", "schema_version": 1, "at": "@t:10", "effective_at": "@t:10", "actor_kind": "owner", "actor_id": "$user:owner", "project_id": "$project:site", "task_id": "$task:1", "round": 0, "subject_kind": null, "subject_id": null, "cause_id": null, "command_id": "$key:t1_complete", "payload": {"contract_version": 1, "added_criterion_ids": ["$criterion:t1_build", "$criterion:t1_review"], "reset_criterion_ids": [], "removed_criterion_ids": [], "added_action_ids": [], "removed_action_ids": []}},
          {"ref": "@event:4", "type": "task.ready", "schema_version": 1, "at": "@t:10", "effective_at": "@t:10", "actor_kind": "owner", "actor_id": "$user:owner", "project_id": "$project:site", "task_id": "$task:1", "round": 0, "subject_kind": null, "subject_id": null, "cause_id": null, "command_id": "$key:t1_complete", "payload": {"wait_cause": null}}
