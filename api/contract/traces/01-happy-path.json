      "caller": "$seat:builder",
      "command": "claim",
      "operation_id": "claim_next_task",
      "key": "$key:t1_claim_builder",
      "path_params": {},
      "body": {},
      "expect": {
        "outcome": "completed",
        "refusal": null,
        "events": [
          {"ref": "@event:5", "type": "task.claimed", "schema_version": 1, "at": "@t:20", "effective_at": "@t:20", "actor_kind": "seat", "actor_id": "$seat:builder", "project_id": "$project:site", "task_id": "$task:1", "round": 0, "subject_kind": null, "subject_id": null, "cause_id": null, "command_id": "$key:t1_claim_builder", "payload": {"seat_id": "$seat:builder", "credential_id": "$credential:claude_a", "model": "claude-model-1"}}
