          {"ref": "@event:9", "type": "evidence.attached", "schema_version": 1, "at": "@t:300", "effective_at": "@t:300", "actor_kind": "seat", "actor_id": "$seat:builder", "project_id": "$project:site", "task_id": "$task:1", "round": 0, "subject_kind": "evidence", "subject_id": "$evidence:t1_build_300", "cause_id": null, "command_id": "$key:t1_pass_build_300", "payload": {"criterion_id": "$criterion:t1_build", "kind": "link"}}
