      "caller": "$seat:builder",
      "command": "acknowledge_briefing",
      "operation_id": "acknowledge_task_briefing",
      "key": "$key:t1_ack_30",
      "path_params": {"id": "$task:1"},
      "body": {"briefing_hash": "briefing-hash-t1-30"},
      "expect": {
