{
  "name": "01-happy-path",
  "description": "One task from Add task to Done with no hold and no model check: the owner adds it and completes its contract, a builder claims, acknowledges, announces and passes its criterion and submits, and a reviewer of another provider passes it.",
  "covers": [
    "PRD Task lifecycle: Add task, Complete contract, Claim, Acknowledge briefing, Start criterion, Pass criterion, Submit, Claim review, Acknowledge review briefing, Review passes with no outward action.",
    "PRD Steps and timing, rules 1, 2, 5 and 6: wait_contract, wait_ready, briefing, build, finish, wait_review and review touch end to end and sum to the task's lifetime.",
    "PRD How a transition is gated, step 7: the app-checked acceptance-criteria gate writes check.finished at task.before_ready.",
    "PRD Agent interface: a verdict carries tokens and spend, which write cost.reported with the review as subject.",
    "Plan SM-41: task.ready, which opens wait_ready, carries wait_cause."
  ],
  "setup": {
    "settings": {},
    "users": [
      {"id": "$user:owner"}
    ],
    "helpers": [
      {"id": "$helper:mac", "name": "Owner's Mac"}
    ],
    "credentials": [
      {"id": "$credential:codex_r", "kind": "login", "provider": "codex", "name": "Codex R", "state": "active", "limited_until": null, "position": 1, "model": "codex-model-1", "effort": null, "strength_rank": null},
      {"id": "$credential:claude_a", "kind": "login", "provider": "claude", "name": "Claude A", "state": "active", "limited_until": null, "position": 2, "model": null, "effort": null, "strength_rank": null}
    ],
    "seats": [
      {"id": "$seat:builder", "name": "Builder", "provider": "claude", "model": "claude-model-1", "effort": "high", "role": "builder", "strength_rank": 2, "credential_id": "$credential:claude_a", "enabled": true, "paused": false, "last_polled_at": null},
      {"id": "$seat:reviewer", "name": "Reviewer", "provider": "codex", "model": "codex-model-1", "effort": "high", "role": "reviewer", "strength_rank": 2, "credential_id": "$credential:codex_r", "enabled": true, "paused": false, "last_polled_at": null}
    ],
    "projects": [
      {"id": "$project:site", "name": "Website", "budget": null, "spent": 0, "paused": false}
    ],
    "rules": [
      {"id": "$rule:acceptance_criteria", "key": "acceptance_criteria", "origin": "shipped", "enabled": true, "current_version": 1, "current_version_id": "$rule_version:acceptance_criteria_1"},
      {"id": "$rule:specific_details", "key": "specific_details", "origin": "shipped", "enabled": false, "current_version": 1, "current_version_id": "$rule_version:specific_details_1"},
      {"id": "$rule:ask_orchestrator_first", "key": "ask_orchestrator_first", "origin": "shipped", "enabled": true, "current_version": 1, "current_version_id": "$rule_version:ask_orchestrator_first_1"},
      {"id": "$rule:different_provider_review", "key": "different_provider_review", "origin": "shipped", "enabled": true, "current_version": 1, "current_version_id": "$rule_version:different_provider_review_1"},
      {"id": "$rule:escalate_after_failed_reviews", "key": "escalate_after_failed_reviews", "origin": "shipped", "enabled": true, "current_version": 1, "current_version_id": "$rule_version:escalate_after_failed_reviews_1"},
      {"id": "$rule:project_budget_pause", "key": "project_budget_pause", "origin": "shipped", "enabled": true, "current_version": 1, "current_version_id": "$rule_version:project_budget_pause_1"},
      {"id": "$rule:orchestrator_approves_actions", "key": "orchestrator_approves_actions", "origin": "shipped", "enabled": true, "current_version": 1, "current_version_id": "$rule_version:orchestrator_approves_actions_1"}
    ]
  },
  "commands": [
    {
      "at": "@t:0",
      "caller": "$user:owner",
      "command": "add_task",
      "operation_id": "add_task",
      "key": "$key:t1_add",
      "path_params": {},
      "body": {"title": "Update the pricing page", "goal": "The page shows this year's prices.", "project_id": "$project:site", "priority": "normal", "state": "backlog"},
      "expect": {
        "outcome": "completed",
        "refusal": null,
        "events": [
          {"ref": "@event:1", "type": "task.created", "schema_version": 1, "at": "@t:0", "effective_at": "@t:0", "actor_kind": "owner", "actor_id": "$user:owner", "project_id": "$project:site", "task_id": "$task:1", "round": 0, "subject_kind": null, "subject_id": null, "cause_id": null, "command_id": "$key:t1_add", "payload": {"state": "backlog"}}
        ],
        "steps_opened": [
          {"task_id": "$task:1", "kind": "wait_contract", "step_class": "waiting", "round": 0, "subject_kind": null, "subject_id": null, "seat_id": null, "cause_kind": null, "cause_rule_id": null, "opening_event_id": "@event:1"}
        ],
        "steps_closed": []
      }
    },
    {
