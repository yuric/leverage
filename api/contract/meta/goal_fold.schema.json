{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "goal_fold.json",
  "description": "The shape of the goal fold file: the separator, the characters trimmed, and examples of the fold, each a task's title, goal and details before and its details after (task_text_contract_test.rb checks each example against the fold).",
  "type": "object",
  "additionalProperties": false,
  "required": ["description", "separator", "trimmed", "examples"],
  "properties": {
    "description": {"type": "string", "minLength": 1},
    "separator": {"type": "string", "minLength": 1},
    "trimmed": {"type": "string", "minLength": 1},
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "goal", "details", "details_after"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "title": {"type": ["string", "null"]},
          "goal": {"type": ["string", "null"]},
          "details": {"type": ["string", "null"]},
          "details_after": {"type": ["string", "null"]}
        }
      }
    }
  }
}
