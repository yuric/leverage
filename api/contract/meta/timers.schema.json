{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "timers.json",
  "description": "Every timer: its scope, the column its due time is read from, and the events it may write, which are those of its rows in state_machine.json. The sweep triggers the timers and is not one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trigger",
    "timers"
  ],
  "properties": {
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "every_seconds_at_most",
        "records",
        "means",
        "prd_lines"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
        },
        "every_seconds_at_most": {
          "type": "integer",
          "minimum": 1
        },
        "records": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
        },
        "means": {
          "type": "string",
          "minLength": 1
        },
        "prd_lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "timers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timer",
          "scope",
          "due_at",
          "events",
          "prd_lines"
        ],
        "properties": {
          "timer": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
          },
          "scope": {
            "enum": [
              "task",
              "workspace"
            ]
          },
          "due_at": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "plus"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^[a-z_]+\\.[a-z_]+$"
              },
              "plus": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "description": "The due time: the source column, plus the offset named in plus."
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z]+(_[a-z]+)*\\.[a-z]+(_[a-z]+)*$"
            }
          },
          "prd_lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
