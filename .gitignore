# Secrets and local configuration — never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keychain
*.keychain-db

# Database dumps, wherever they are made: a dump holds the owner's email,
# password digest and every task's text (docs/DEPLOY.md). Not *.sql or *.gz,
# which tracked files use (api/db/structure.sql, a stand-in archive).
*.dump
*.dump.partial
*.pgdump
*.sql.gz
dump.sql

# Operating system
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Local agent settings
.claude/settings.local.json

# Logs and temporary files
*.log
tmp/

# Local research working folders (published copies live in docs/research/)
/reports/
/research_notes/

# Python bytecode
__pycache__/

# The Rails API (api/): local bundler settings, logs, keys
/api/.bundle/
/api/log/*
!/api/log/.keep
/api/config/master.key
/api/config/credentials/*.key

# The app bundle scripts/build_app.sh assembles
/dist/

# The daily backup's dumps on a developer's own run (LEVERAGE_BACKUP_DIR)
/backups/
