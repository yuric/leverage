# Make .env from this file with `python3 -I scripts/make_env.py`, which
# replaces every change-me value with a random value of its own (or copy it
# and replace them by hand). .env is git-ignored; never commit it.
# compose.yaml reads it.

# The PostgreSQL user and password for the db container. The api container
# builds DATABASE_URL from them, so use only letters, digits and dashes.
POSTGRES_USER=leverage
POSTGRES_PASSWORD=change-me-local-only

# The password of leverage_api, the database login role the API server and
# the sweep connect as; it holds only the application's rights (no right to
# change or delete events). Use only letters, digits and dashes. Left
# empty, the server and the sweep connect with POSTGRES_USER instead.
LEVERAGE_API_DB_PASSWORD=change-me-made-up-api-role-password

# Rails signs cookies and tokens with this. Make a new one with:
#   openssl rand -hex 64
SECRET_KEY_BASE=change-me-made-up-value-replace-with-openssl-rand-hex-64

# The API runs on plain HTTP on 127.0.0.1 during the first run on the Mac.
# Set both to true once TLS is in front of it.
RAILS_ASSUME_SSL=false
RAILS_FORCE_SSL=false

# The port on 127.0.0.1 where the API answers. Change it only if 3000 is
# already taken on the Mac.
API_PORT=3000

# The folder on the Mac where the daily backup writes its dumps (the backup
# service mounts it at /backups). ./backups is for a developer's own run
# and is git-ignored; the app uses a folder in its own support folder. On
# Linux it must be a folder the image's user, uid 1000, can write.
LEVERAGE_BACKUP_DIR=./backups
